:root {
}

.health {
    color: red;
}

.power {
    color: springgreen;
}

Label {
    font-size: 18px;
    -unity-font-style: bold;
    -unity-font-definition: resource("FlatSkin/Font/Roboto-ThinItalic");
}

.powerRow,
.healthRow {
    flex-grow: 0;
    flex-direction: row;
    /*justify-content: center;*/
    align-self: flex-start;
    min-width: 130px;
}

.healthBar .unity-progress-bar__progress {
    background-color: rgb(255, 0, 0);
}

.healthBar .unity-progress-bar__background {
    background-color: rgb(72, 61, 61);
}

.powerBar .unity-progress-bar__progress {
    background-color: rgb(0, 255, 0);
}

.powerBar .unity-progress-bar__background {
    background-color: rgb(72, 61, 61);
}

